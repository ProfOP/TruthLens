# Copy this file to `.env` and replace every placeholder. Never commit `.env`,
# never paste real values into chat/issue/PR text.
# Generate secrets locally, e.g. in PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})

# ---------------------------------------------------------------------------
# Used by `docker compose` (docker-compose.yml interpolates these)
# ---------------------------------------------------------------------------
# Postgres superuser password AND the backend datasource password (same value).
POSTGRES_PASSWORD=replace-with-a-local-secret
# REQUIRED: compose fails fast if unset. Minimum 32 characters, signing key only.
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional candidate-evidence discovery (FEVER page-title retrieval pilot, merge@N=5).
# 0 = off: /v1/verify returns exactly what it did before. 1 = on: responses gain a
# related_passages block of top-5 candidate passages that are NOT used for the verdict.
# On a fresh clone keep 0: the pilot index it reads is not part of the Git repo.
TRUTHLENS_RELATED_PASSAGES=0

# ---------------------------------------------------------------------------
# Used by the native startup scripts (scripts/start-local.ps1) — the Docker
# stack sets its own network-equivalent values inside docker-compose.yml and
# ignores these.
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/truthlens
SPRING_DATASOURCE_USERNAME=truthlens
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-secret
AI_SERVICE_URL=http://localhost:8001
TRUTHLENS_STORAGE_DIR=storage
# Deployment abstention overrides; exported model JSON remains unchanged.
TRUTHLENS_TEXT_CONFIDENCE_THRESHOLD=0.70
TRUTHLENS_IMAGE_UNCERTAIN_MARGIN=0.05
# Guest submission is intentionally disabled; private analysis requires login.
# Admin bootstrap (optional, never a default password) — see README "First sign-in".
# TRUTHLENS_BOOTSTRAP_ADMIN_EMAIL=
# TRUTHLENS_BOOTSTRAP_ADMIN_NAME=
# TRUTHLENS_BOOTSTRAP_ADMIN_PASSWORD=
# Note: browser origins are not configurable here. CORS allows only
# http://localhost:5173 and http://127.0.0.1:5173 (backend SecurityConfig).
